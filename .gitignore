# ─────────────────────────────────────────────────────────────
# Whitelist mode: ignore everything by default and opt in only the
# files that belong in version control. When adding a new top-level
# file or directory, add a matching ! rule here.
# ─────────────────────────────────────────────────────────────
/*

# Repository metadata
!/.gitignore
!/.gitattributes
!/AGENT.md
!/CLAUDE.md
!/.github/
!/.github/**
!/LICENSE
!/README.md
!/README.zh-CN.md
!/CONTRIBUTING.md
!/SECURITY.md
!/assets/
!/assets/**
!/docs/
!/docs/**

# Frontend
!/package.json
!/bun.lock
!/index.html
!/tsconfig.json
!/tsconfig.node.json
!/vite.config.ts
!/scripts/
!/scripts/**
!/src/
!/src/**
!/public/
!/public/**

# Desktop core
!/src-tauri/
!/src-tauri/**
